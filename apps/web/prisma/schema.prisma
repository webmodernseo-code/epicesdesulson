
// Prisma Schema for Les Épices de Sulson
// Ready for Neon PostgreSQL (Serverless & Connection Pooling)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
  MASTER_ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  phone         String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]
  reviews       Review[]

  @@map("users")
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  street      String
  city        String
  postalCode  String
  country     String   @default("France")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("addresses")
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  image       String?
  products    Product[]
  createdAt   DateTime  @default(now())

  @@map("categories")
}

model Product {
  id             String          @id @default(cuid())
  slug           String          @unique
  code           String          @unique // e.g. SUL-301
  title          String
  subtitle       String?
  description    String
  origin         String          @default("Cameroun (Recette Traditionnelle)")
  basePrice      Decimal         @db.Decimal(10, 2)
  baseOldPrice   Decimal?        @db.Decimal(10, 2)
  ratingScore    Decimal         @default(4.9) @db.Decimal(3, 2)
  ratingCount    Int             @default(150)
  imageRecto     String
  imageVerso     String?
  isFeatured     Boolean         @default(false)
  isAvailable    Boolean         @default(true)
  stockQuantity  Int             @default(100)
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  formats        ProductFormat[]
  orderItems     OrderItem[]
  reviews        Review[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("products")
}

model ProductFormat {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label       String   // e.g. "50g", "100g", "250g", "500g", "1 Kg", "Pack 4x50g"
  weightGrams Int      // e.g. 50, 100, 250, 500, 1000
  multiplier  Decimal  @db.Decimal(4, 2) // e.g. 1.0, 1.85, 4.2, 7.8, 14.5
  price       Decimal  @db.Decimal(10, 2)
  oldPrice    Decimal? @db.Decimal(10, 2)
  inStock     Boolean  @default(true)

  @@map("product_formats")
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique // e.g. SUL-10842
  userId            String?
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName      String
  customerEmail     String
  customerPhone     String?
  shippingStreet    String
  shippingCity      String
  shippingPostal    String
  shippingCountry   String        @default("France")
  
  subtotal          Decimal       @db.Decimal(10, 2)
  shippingCost      Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount    Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount       Decimal       @db.Decimal(10, 2)
  
  status            OrderStatus   @default(PENDING)
  paymentStatus     PaymentStatus @default(UNPAID)
  paymentMethod     String        @default("stripe")
  stripeSessionId   String?       @unique
  stripePaymentId   String?       @unique
  
  items             OrderItem[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  formatLabel String   // e.g. "250g"
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)

  @@map("order_items")
}

model Review {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName  String
  rating      Int      @default(5)
  comment     String
  verified    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("reviews")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model PaymentGatewayConfig {
  id                   String   @id @default(cuid())
  gateway              String   @unique // "stripe", "paypal", "apple_pay"
  isEnabled            Boolean  @default(false)
  isLiveMode           Boolean  @default(false)
  
  // Configuration Stripe
  stripePublishableKey String?
  stripeSecretKey      String?
  stripeWebhookSecret  String?
  
  // Configuration PayPal
  paypalClientId       String?
  paypalSecretKey      String?
  
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())

  @@map("payment_gateway_configs")
}

model MediaStorageConfig {
  id            String   @id @default(cuid())
  provider      String   @unique @default("cloudinary")
  cloudName     String
  apiKey        String
  apiSecret     String
  uploadFolder  String   @default("les-epices-de-sulson/products")
  isEnabled     Boolean  @default(false)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@map("media_storage_configs")
}

model SmtpEmailConfig {
  id          String   @id @default(cuid())
  host        String   @default("smtp.gmail.com")
  port        Int      @default(465)
  secure      Boolean  @default(true)
  user        String
  password    String
  fromName    String   @default("Les Épices de Sulson")
  fromEmail   String   @default("contact@epicesdesulson.com")
  isEnabled   Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("smtp_email_configs")
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique // e.g. "SULSON10", "ETE20", "VIP15"
  description     String?   // e.g. "Remise spéciale 10%"
  discountPercent Decimal   @db.Decimal(5, 2) // e.g. 10.00, 15.00, 20.00
  isActive        Boolean   @default(true)
  minOrderAmount  Decimal?  @db.Decimal(10, 2)
  expiresAt       DateTime?
  usageCount      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("coupons")
}

