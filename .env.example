# ==============================================================================
# ENVIRONMENT CONFIGURATION - LES ÉPICES DE SULSON
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL="postgresql://sulson_user:sulson_secure_password@ep-cool-resonance-123456.eu-central-1.aws.neon.tech/sulson_db?sslmode=require"

# Direct connection string for Prisma migrations (non-pooled)
DIRECT_URL="postgresql://sulson_user:sulson_secure_password@ep-cool-resonance-123456.eu-central-1.aws.neon.tech/sulson_db?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (NextAuth / JWT)
# ------------------------------------------------------------------------------
# Generate via: openssl rand -base64 32
NEXTAUTH_SECRET="your_32_characters_random_secret_key_sulson_2026"
NEXTAUTH_URL="http://localhost:3000"
SUPER_ADMIN_EMAIL="contact@epicesdesulson.com"
SUPER_ADMIN_NAME="Administrateur principal Sulson"
SUPER_ADMIN_INITIAL_PASSWORD="replace_with_a_unique_password_of_at_least_12_characters"

# ------------------------------------------------------------------------------
# 3. PAYMENTS (Stripe)
# ------------------------------------------------------------------------------
# Test keys begin with pk_test_ and sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder_key"
STRIPE_SECRET_KEY="sk_test_placeholder_key"
STRIPE_WEBHOOK_SECRET="whsec_placeholder_key"

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAILS (Resend / SendGrid)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_placeholder_key"
EMAIL_FROM="Les Épices de Sulson <commandes@lesepicesdesulson.com>"
ADMIN_NOTIFICATION_EMAIL="contact@lesepicesdesulson.com"

# ------------------------------------------------------------------------------
# 5. APPLICATION PORTS & HOSTS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DASHBOARD_URL="http://localhost:3001"
NODE_ENV="development"
